# Local SQLite development can use this path instead of TALARIA_DATABASE_URL.
# TALARIA_DATABASE=.talaria/talaria.db
# Use TLS in production; verify-full with the provider CA is preferred.
TALARIA_DATABASE_URL=postgresql://talaria@localhost:5432/talaria?sslmode=require
TALARIA_POSTGRES_PASSWORD_FILE=./secrets/postgres-password.txt
TALARIA_BACKUP_DIR=./backups
# Check this private bridge subnet against existing host and Docker networks.
TALARIA_EDGE_SUBNET=172.30.20.0/24
TALARIA_CADDY_IP=172.30.20.2
# Required when starting with docker-compose.tls.yml; point DNS at this host.
# TALARIA_DOMAIN=talaria.example.com
TALARIA_JWT_SECRET_FILE=./secrets/jwt-secret.txt
# Keep empty to disable HTTP bootstrap; set this to a one-time random file only during setup.
TALARIA_BOOTSTRAP_TOKEN_FILE=./secrets/bootstrap-token.example
# Maximum source file size read by a scan (1024 to 50000000 bytes).
TALARIA_MAX_FILE_BYTES=2000000
# API repository scans are limited to the current working directory by default.
# Set one or more canonical roots separated by the operating-system path separator.
# TALARIA_ALLOWED_REPOSITORY_ROOTS=/Users/you/Projects:/work/security
# Local runs can set TALARIA_JWT_SECRET directly; Compose reads the configured secret file.
# The empty bootstrap-token example keeps the one-time HTTP endpoint disabled.
# GitHub App configuration is optional; store private keys outside this file.
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET_FILE=./secrets/github-webhook-secret.txt
# AI analysis is disabled unless explicitly enabled; source excerpts are omitted
# unless TALARIA_AI_SEND_SOURCE=true is set after a data-handling review.
TALARIA_AI_ENABLED=false
TALARIA_AI_SEND_SOURCE=false
TALARIA_AI_TIMEOUT_SECONDS=20
# Optional bearer token to enable the private, bounded /metrics endpoint.
# Keep empty to disable it; do not expose /metrics through a public ingress.
TALARIA_METRICS_TOKEN=
# For opt-in analysis, point this to a local provider key file and configure
# the provider endpoint/model. Do not put source-sharing approval in this file.
# TALARIA_LLM_API_KEY_FILE=./secrets/llm-api-key.txt
# TALARIA_LLM_BASE_URL=https://provider.example/v1
# TALARIA_LLM_MODEL=
